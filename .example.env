# -------------------------------
# Dataset and split configuration
# -------------------------------
MAX_ROWS=10000
TRAIN_RATIO=0.8
TARGET_COLUMN=OT

# -------------------------------
# LSTM + Optuna configuration
# -------------------------------
SEQ_LEN=96
PRED_LEN=24
NUM_EPOCHS=5
N_TRIALS=20
LSTM_MODEL_NAME=lstm-optuna
ARTIFACTS_DIR=artifacts
DEVICE_TYPE=auto         # auto | cpu | cuda | mps

# -------------------------------
# Informer + Optuna configuration
# -------------------------------
INFORMER_NUM_EPOCHS=10
INFORMER_TIMEOUT_SECONDS=3600
INFORMER_N_TRIALS=10
INFORMER_METRICS_ROOT=artifacts/informer_optuna

# -------------------------------
# LLM agent configuration
# -------------------------------
LLM_PROVIDER=lmstudio           # lmstudio | deepseek
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=your-lmstudio-model-name

LLM_NUM_EPOCHS=5
LLM_NUM_INITIAL_CANDIDATES=2
LLM_NUM_CROSSOVER_CANDIDATES=3
LLM_METRIC_NAME=mse

# -------------------------------
# DeepSeek-specific configuration
# (used only if LLM_PROVIDER=deepseek)
# -------------------------------
DEEPSEEK_API_KEY=your-deepseek-api-key