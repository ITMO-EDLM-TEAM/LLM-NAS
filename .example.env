# Режим работы приложения:
# llm-search      — поиск архитектур с LLM-агентом
# optuna-baseline — baseline с Optuna
MODE=llm-search

# Путь к задаче и датасету ETTm1
PROBLEM_DIR=./examples/et

# --- Настройки LLM-поиска (LM Studio) ---

# Провайдер LLM: lmstudio или deepseek
LLM_PROVIDER=lmstudio

# Имя модели в LM Studio (см. UI LM Studio, вкладка "Server")
LLM_MODEL_NAME=your-lmstudio-model-name

# Базовый URL OpenAI-совместимого сервера LM Studio
# По умолчанию LM Studio поднимает сервер на http://localhost:1234/v1
LLM_BASE_URL=http://localhost:1234/v1

# Сколько кандидатов максимум оценивать за один запуск поиска
MAX_CANDIDATES=5

# Из каких лучших кандидатов выбирать родителей для скрещивания
TOP_K_FOR_CROSSOVER=3

# --- Настройки Optuna baseline ---

# Длина входной последовательности для LSTM baseline
SEQ_LEN=96

# Длина горизонта прогноза
PRED_LEN=24

# Количество эпох обучения для baseline-модели в каждом trial
NUM_EPOCHS=5

# Число trial'ов Optuna
N_TRIALS=20

# --- DeepSeek (опционально, если захочешь поменять провайдера) ---

# LLM_PROVIDER=deepseek
# LLM_MODEL_NAME=deepseek-coder
# LLM_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=your-deepseek-api-key