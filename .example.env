# .example.env
# -------------------------------
# Dataset and split configuration
# -------------------------------
MAX_ROWS=5000
TRAIN_RATIO=0.8
TARGET_COLUMN=OT

# -------------------------------
# Agent configuration
# -------------------------------
CHAT_CLIENT_PROVIDER=lmstudio         # lmstudio | deepseek | openai
AGENT_NUM_EPOCHS=5
AGENT_NUM_INITIAL_CANDIDATES=2
AGENT_NUM_CROSSOVER_CANDIDATES=3
AGENT_METRIC_NAME=mse

# -------------------------------
# LM Studio client configuration
# -------------------------------
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL_NAME=your-lmstudio-model-name
LM_STUDIO_TEMPERATURE=0.1
LM_STUDIO_TOP_P=0.95

# -------------------------------
# DeepSeek client configuration
# -------------------------------
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL_NAME=deepseek-reasoner
DEEPSEEK_API_KEY=""
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_TOP_P=0.95

# -------------------------------
# OpenAI-like client configuration
# -------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEMPERATURE=0.6
OPENAI_TOP_P=0.85

# -------------------------------
# LLM agent artifacts configuration
# -------------------------------
LLM_AGENT_ARTIFACTS_ROOT=artifacts/llm_agent

# -------------------------------
# LSTM + Optuna configuration
# -------------------------------
N_TRIALS=20
LSTM_MODEL_NAME=lstm-optuna
ARTIFACTS_DIR=artifacts
DEVICE_TYPE=auto         # auto | cpu | cuda | mps

# LSTM search space (JSON object, single line, all keys required)
# Keys: seq_len, pred_len, num_epochs, hidden_size, num_layers, learning_rate, batch_size
LSTM_SEARCH_SPACE_JSON={"seq_len":[25,50,100,200,500],"pred_len":[1,10,25],"num_epochs":[5,10,15,20],"hidden_size":[32,64,128,256],"num_layers":[1,3,6,10],"learning_rate":[0.0001,0.0003,0.001,0.003,0.01],"batch_size":[32,64,128,256]}

# -------------------------------
# Informer + Optuna configuration
# -------------------------------
INFORMER_TIMEOUT_SECONDS=3600
INFORMER_N_TRIALS=10
INFORMER_METRICS_ROOT=artifacts/informer_optuna

# Informer search space (JSON object, single line, all keys required)
# Keys: d_model, n_heads, e_layers, d_layers, factor, dropout, learning_rate, batch_size, epochs
INFORMER_SEARCH_SPACE_JSON={"d_model":[128,192,256,320,384,448,512],"n_heads":[2,4,8],"e_layers":[1,3,6,10],"d_layers":[1,2,3],"factor":[1,3,5],"dropout":[0.05,0.1,0.2,0.3],"learning_rate":[0.00001,0.00003,0.0001,0.0003,0.001],"batch_size":[16,32,64],"epochs":[5,10,20]}